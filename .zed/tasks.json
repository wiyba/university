[
  {
    "label": "c++: build",
    "command": "mkdir -p \"$ZED_WORKTREE_ROOT/build/$ZED_RELATIVE_DIR\" && c++ -std=c++20 -O0 -g -Wall -Wextra -o \"$ZED_WORKTREE_ROOT/build/$ZED_RELATIVE_DIR/$ZED_STEM\" \"$ZED_FILE\" -lsodium",
    "reveal": "no_focus",
    "hide": "on_success"
  },
  {
    "label": "c++: run",
    "command": "mkdir -p \"$ZED_WORKTREE_ROOT/build/$ZED_RELATIVE_DIR\" && c++ -std=c++20 -O0 -g -Wall -Wextra -o \"$ZED_WORKTREE_ROOT/build/$ZED_RELATIVE_DIR/$ZED_STEM\" \"$ZED_FILE\" -lsodium && \"$ZED_WORKTREE_ROOT/build/$ZED_RELATIVE_DIR/$ZED_STEM\"",
    "cwd": "$ZED_DIRNAME",
    "reveal": "always"
  },
  {
    "label": "typst: compile",
    "command": "mkdir -p \"$ZED_WORKTREE_ROOT/build/$ZED_RELATIVE_DIR\" && typst compile --root \"$ZED_WORKTREE_ROOT\" \"$ZED_FILE\" \"$ZED_WORKTREE_ROOT/build/$ZED_RELATIVE_DIR/$ZED_STEM.pdf\"",
    "reveal": "no_focus",
    "hide": "on_success"
  },
  {
    "label": "typst: watch",
    "command": "mkdir -p \"$ZED_WORKTREE_ROOT/build/$ZED_RELATIVE_DIR\" && typst watch --root \"$ZED_WORKTREE_ROOT\" --open \"$ZED_FILE\" \"$ZED_WORKTREE_ROOT/build/$ZED_RELATIVE_DIR/$ZED_STEM.pdf\"",
    "reveal": "always"
  }
]
